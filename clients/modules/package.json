{
  "name": "@cordis-net/client-modules",
  "version": "0.2.0-alpha.4",
  "private": true,
  "type": "module",
  "description": "Fixed DSH browser module loading over Cordis, with a native Host artifact protocol",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/types/src/index.d.ts",
      "default": "./lib/client.mjs"
    },
    "./slots": {
      "types": "./lib/types/vendor/slots/index.d.ts",
      "default": "./lib/client.mjs"
    },
    "./management": {
      "types": "./lib/types/standard/management.d.ts",
      "default": "./lib/management.mjs"
    },
    "./notifications": {
      "types": "./lib/types/standard/notifications.d.ts",
      "default": "./lib/notifications.mjs"
    },
    "./settings": {
      "types": "./lib/types/standard/settings.d.ts",
      "default": "./lib/settings.mjs"
    }
  },
  "files": [
    "lib",
    "vendor/provenance.json",
    "vendor/*/LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-client-modules.mjs",
    "typecheck": "node ../../scripts/build-client-modules.mjs --types-only"
  },
  "devDependencies": {
    "@standard-schema/spec": "1.0.0",
    "@types/node": "22.19.0",
    "@types/prop-types": "15.7.12",
    "@types/react": "18.3.1",
    "csstype": "3.1.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
