{
  "name": "@cordis-net/client-modules",
  "version": "0.2.1-alpha.4",
  "private": true,
  "type": "module",
  "description": "Fixed DSH browser module loading over Cordis, with a native Host artifact protocol",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/types/src/index.d.ts",
      "default": "./lib/client.mjs"
    },
    "./access": {
      "types": "./lib/types/src/access.d.ts",
      "default": "./lib/access.mjs"
    },
    "./slots": {
      "types": "./lib/types/npm/@deepseek-ai/dsh-client-ui-slots/index.d.ts",
      "default": "./lib/slots.mjs"
    },
    "./management": {
      "types": "./lib/types/standard/management.d.ts",
      "default": "./lib/management.mjs"
    },
    "./events": {
      "types": "./lib/types/standard/events.d.ts",
      "default": "./lib/events.mjs"
    },
    "./settings": {
      "types": "./lib/types/standard/settings.d.ts",
      "default": "./lib/settings.mjs"
    }
  },
  "files": [
    "lib",
    "vendor/provenance.json",
    "vendor/*/LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-client-modules.mjs",
    "typecheck": "node ../../scripts/build-client-modules.mjs --types-only"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-package-manifest": "0.2.1-rc.2",
    "@standard-schema/spec": "1.1.0",
    "@types/node": "22.19.0",
    "@types/prop-types": "15.7.12",
    "@types/react": "18.3.1",
    "csstype": "3.1.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
