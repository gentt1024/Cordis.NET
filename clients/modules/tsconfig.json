{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "declaration": true, "emitDeclarationOnly": true,
    "rootDir": ".", "outDir": ".types/sdk",
    "paths": { "@cordis-net/modules/*": ["./.types/vendor/modules/*.d.ts"] }
  },
  "include": ["src/**/*.ts"]
}
