<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0-alpha.1</Version>
    <Authors>gentt1024 and Cordis.NET contributors</Authors>
    <Description>A native .NET implementation of the pinned DeepSeek Harness Cordis model.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>dotnet;plugin-system;modularity;cordis</PackageTags>
    <PackageReleaseNotes>Initial preview aligned with the pinned DeepSeek Harness Cordis baseline.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/gentt1024/Cordis.NET.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/gentt1024/Cordis.NET</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
  </PropertyGroup>
</Project>
