<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>10.0</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.2.1-alpha.4</Version>
    <Authors>gentt1024 and Cordis.NET contributors</Authors>
    <Description>A native .NET implementation of the pinned DeepSeek Harness Cordis model.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>dotnet;plugin-system;modularity;cordis</PackageTags>
    <PackageReleaseNotes>Build CLR plugins from local source, manage profile dependencies offline and register trusted workspaces through a running Host. Compose Entry and patch configuration schemas from a prepared profile. Distribute the matching browser SDK with its shared modules. See the changelog for migration and validation details.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/gentt1024/Cordis.NET.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/gentt1024/Cordis.NET</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EmbedAllSources>true</EmbedAllSources>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)Cordis.SourceArchive.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Cordis.SourceArchive.props') and !Exists('$(MSBuildThisFileDirectory).git')" />
</Project>
