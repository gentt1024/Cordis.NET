<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>10.0</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.2.0-alpha.5</Version>
    <Authors>gentt1024 and Cordis.NET contributors</Authors>
    <Description>A native .NET implementation of the pinned DeepSeek Harness Cordis model.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>dotnet;plugin-system;modularity;cordis</PackageTags>
    <PackageReleaseNotes>Common declaration models and generated .NET/Web Remote contracts; scoped calls, streams and typed events; numeric Settings and generated management over existing operations; stable CLR artifacts; reusable output schemas, native readonly result metadata, prepared-candidate admission, local unary causes and bounded Web numeric input. Fixed DSH baseline unchanged. See the matching source documentation for support and release status.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/gentt1024/Cordis.NET.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/gentt1024/Cordis.NET</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EmbedAllSources>true</EmbedAllSources>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)Cordis.SourceArchive.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Cordis.SourceArchive.props') and !Exists('$(MSBuildThisFileDirectory).git')" />
</Project>
